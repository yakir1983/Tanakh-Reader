# Copy this file to .env.local for local overrides (never commit .env.local).
#
# Leave empty on Replit — the built-in path router forwards /api/* to port 8080.
# On Netlify (or any external static host), set this to your API server's origin:
#
# VITE_API_BASE_URL=https://tanakh-reader.<your-username>.replit.app
VITE_API_BASE_URL=
