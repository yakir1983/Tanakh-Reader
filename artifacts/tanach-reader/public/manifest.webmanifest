{
  "name": "קורא תנ\"ך ורש\"י",
  "short_name": "קורא תנ\"ך",
  "description": "קראו את התנ\"ך עם פירוש רש\"י, ניווט קולי בעברית ותשובות בינה מלאכותית לכל שאלה על הפסוק.",
  "id": "/",
  "scope": "/",
  "start_url": "/?source=pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "dir": "rtl",
  "lang": "he",
  "background_color": "#1086C0",
  "theme_color": "#1086C0",
  "categories": ["education", "books", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": {
